// defaults snapshot taken on first run, used by "reset to default"
static bool  defaults_captured = false;
static bool  def_checks[7][16] = { false };
static int   def_sliders[7][16] = { 0 };
static int   def_dropdowns[7][16] = { 0 };
static float def_colors[7][20][4] = {};

static bool boot_config_loaded = false;

static std::string config_dir()
{
    char base[MAX_PATH] = {};
    DWORD n = GetEnvironmentVariableA("APPDATA", base, MAX_PATH);
    std::string dir = (n > 0 && n < MAX_PATH) ? std::string(base) : std::string();
    if (!dir.empty())
    {
        if (dir.back() != '\\') dir += '\\';
        dir += "Vade\\";
        CreateDirectoryA(dir.c_str(), nullptr);
        DWORD attr = GetFileAttributesA(dir.c_str());
        if (attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY))
            return dir;
    }

    char tmp[MAX_PATH] = {};
    if (GetTempPathA(MAX_PATH, tmp))
    {
        dir = std::string(tmp) + "vade\\";
        CreateDirectoryA(dir.c_str(), nullptr);
        return dir;
    }
    return std::string();
}

static std::string config_path(int slot)
{
    char name[32];
    sprintf_s(name, "slot%d.cfg", slot);
    return config_dir() + name;
}

static std::string export_path()
{
    return config_dir() + "export.cfg";
}

static void write_boot_cfg(int slot, bool auto_load)
{
    FILE* b = nullptr;
    if (fopen_s(&b, (config_dir() + "boot.cfg").c_str(), "wb"))
        return;

    fprintf(b, "slot=%d\n", slot);
    fprintf(b, "auto_load=%d\n", auto_load ? 1 : 0);
    fclose(b);
}

bool c_gui::save_config(int slot)
{
    if (slot < 1 || slot > 5)
        return false;

    FILE* f = nullptr;
    if (fopen_s(&f, config_path(slot).c_str(), "wb"))
        return false;

    fprintf(f, "vade=1\n");
    fprintf(f, "auto_load=%d\n", cfg_auto_load ? 1 : 0);
    fprintf(f, "save_on_exit=%d\n", cfg_save_on_exit ? 1 : 0);
    fprintf(f, "win.rounding=%.3f\n", elements->window.rounding);

    for (int t = 0; t < 7; t++)
    {
        for (int i = 0; i < 16; i++)
            fprintf(f, "chk.%d.%d=%d\n", t, i, test_checks[t][i] ? 1 : 0);

        for (int i = 0; i < 16; i++)
            fprintf(f, "sld.%d.%d=%d\n", t, i, test_sliders[t][i]);

        for (int i = 0; i < 16; i++)
            fprintf(f, "ddn.%d.%d=%d\n", t, i, test_dropdowns[t][i]);

        for (int i = 0; i < 4; i++)
            fprintf(f, "kbd.%d.%d=%d,%d\n", t, i, bind_key[t][i], bind_mode[t][i]);

        for (int i = 0; i < 20; i++)
            for (int c = 0; c < 4; c++)
                fprintf(f, "clr.%d.%d.%d=%.5f\n", t, i, c, test_colors[t][i][c]);
    }

    fprintf(f, "show.watermark=%d\n", var->gui.show_watermark ? 1 : 0);
    fprintf(f, "show.hotkeys=%d\n", var->gui.show_active_hotkeys ? 1 : 0);
    fprintf(f, "show.playerbar=%d\n", var->gui.show_playerbar ? 1 : 0);
    fprintf(f, "show.playerlist=%d\n", var->gui.show_playerlist ? 1 : 0);
    fprintf(f, "show.musicplayer=%d\n", var->gui.show_spotify ? 1 : 0);

    for (const auto& kb : keybinds->items())
        fprintf(f, "kbn=%s|%d|%d|%d\n", kb.name.c_str(), kb.key, (int)kb.mode, kb.active ? 1 : 0);

    fclose(f);

    cfg_slot = slot;
    write_boot_cfg(slot, cfg_auto_load);
    return true;
}

bool c_gui::load_config(int slot)
{
    if (slot < 1 || slot > 5)
        return false;

    FILE* f = nullptr;
    if (fopen_s(&f, config_path(slot).c_str(), "rb"))
        return false;

    char line[192];
    while (fgets(line, (int)sizeof(line), f))
    {
        line[strcspn(line, "\r\n")] = 0;

        char* eq = strchr(line, '=');
        if (!eq || eq == line)
            continue;

        *eq = 0;
        const char* k = line;
        const char* v = eq + 1;

        int a = 0, b = 0, c = 0;

        if (sscanf_s(k, "chk.%d.%d", &a, &b) == 2 && a < 7 && b < 16)
            test_checks[a][b] = atoi(v) != 0;
        else if (sscanf_s(k, "sld.%d.%d", &a, &b) == 2 && a < 7 && b < 16)
            test_sliders[a][b] = atoi(v);
        else if (sscanf_s(k, "ddn.%d.%d", &a, &b) == 2 && a < 7 && b < 16)
            test_dropdowns[a][b] = atoi(v);
        else if (sscanf_s(k, "kbd.%d.%d", &a, &b) == 2 && a < 7 && b < 4)
        {
            int key = -1, mode = 0;
            if (sscanf_s(v, "%d,%d", &key, &mode) == 2)
            {
                bind_key[a][b] = key;
                bind_mode[a][b] = mode;
            }
        }
        else if (sscanf_s(k, "clr.%d.%d.%d", &a, &b, &c) == 3 && a < 7 && b < 20 && c < 4)
            test_colors[a][b][c] = (float)atof(v);
        else if (strcmp(k, "auto_load") == 0)
            cfg_auto_load = atoi(v) != 0;
        else if (strcmp(k, "save_on_exit") == 0)
            cfg_save_on_exit = atoi(v) != 0;
        else if (strcmp(k, "win.rounding") == 0)
            elements->window.rounding = (float)atof(v);
        else if (strcmp(k, "show.watermark") == 0)
            var->gui.show_watermark = atoi(v) != 0;
        else if (strcmp(k, "show.hotkeys") == 0)
            var->gui.show_active_hotkeys = atoi(v) != 0;
        else if (strcmp(k, "show.playerbar") == 0)
            var->gui.show_playerbar = atoi(v) != 0;
        else if (strcmp(k, "show.playerlist") == 0)
            var->gui.show_playerlist = atoi(v) != 0;
        else if (strcmp(k, "show.musicplayer") == 0)
            var->gui.show_spotify = atoi(v) != 0;
        else if (strcmp(k, "kbn") == 0)
        {
            char nm[64] = {};
            int kd = 0, md = 0, ac = 0;
            if (sscanf_s(v, "%63[^|]|%d|%d|%d", nm, (unsigned)_countof(nm), &kd, &md, &ac) == 4)
            {
                for (auto& item : keybinds->items())
                {
                    if (item.name == nm)
                    {
                        item.key    = kd;
                        item.mode   = (keybind_mode)md;
                        item.active = ac != 0;
                    }
                }
            }
        }
    }

    fclose(f);
    cfg_slot = slot;
    return true;
}

void c_gui::delete_config(int slot)
{
    if (slot < 1 || slot > 5)
        return;

    DeleteFileA(config_path(slot).c_str());

    if (cfg_slot == slot)
        write_boot_cfg(slot, cfg_auto_load);
}

void c_gui::reset_defaults()
{
    if (!defaults_captured)
        return;

    memcpy(test_checks, def_checks, sizeof(def_checks));
    memcpy(test_sliders, def_sliders, sizeof(def_sliders));
    memcpy(test_dropdowns, def_dropdowns, sizeof(def_dropdowns));
    memcpy(test_colors, def_colors, sizeof(def_colors));

    memset(bind_key, 0, sizeof(bind_key));
    memset(bind_mode, 0, sizeof(bind_mode));
}

void c_gui::boot_config()
{
    if (boot_config_loaded)
        return;

    boot_config_loaded = true;

    memcpy(def_checks, test_checks, sizeof(def_checks));
    memcpy(def_sliders, test_sliders, sizeof(def_sliders));
    memcpy(def_dropdowns, test_dropdowns, sizeof(def_dropdowns));
    memcpy(def_colors, test_colors, sizeof(def_colors));
    defaults_captured = true;

    if (keybinds)
        keybinds->seed_defaults();

    int slot = cfg_slot;
    bool auto_load = cfg_auto_load;

    FILE* b = nullptr;
    if (!fopen_s(&b, (config_dir() + "boot.cfg").c_str(), "rb"))
    {
        char line[64];
        while (fgets(line, (int)sizeof(line), b))
        {
            line[strcspn(line, "\r\n")] = 0;

            int s = 0;
            if (sscanf_s(line, "slot=%d", &s) == 1 && s >= 1 && s <= 5)
                slot = s;
            else if (sscanf_s(line, "auto_load=%d", &s) == 1)
                auto_load = s != 0;
        }
        fclose(b);
    }

    cfg_slot = slot;
    cfg_auto_load = auto_load;

    if (cfg_auto_load)
        load_config(cfg_slot);
}

void c_gui::render()
{
	gui->easing(var->gui.watermark_spawn_alpha,      var->gui.show_watermark       ? 1.0f : 0.0f, 8.0f, dynamic_easing);
	gui->easing(var->gui.active_hotkeys_spawn_alpha, var->gui.show_active_hotkeys  ? 1.0f : 0.0f, 4.0f, dynamic_easing);
	gui->easing(var->gui.playerbar_spawn_alpha,      var->gui.show_playerbar       ? 1.0f : 0.0f, 8.0f, dynamic_easing);
	gui->easing(var->gui.spotify_spawn_alpha,        var->gui.show_spotify         ? 1.0f : 0.0f, 8.0f, dynamic_easing);
	gui->easing(var->gui.playerlist_spawn_alpha,     var->gui.show_playerlist      ? 1.0f : 0.0f, 8.0f, dynamic_easing);

	deezer->update();

	// binds must keep responding even when the overlay is hidden
	keybinds->update();

	if (!var->gui.menu_open)
	{
		var->gui.menu_was_closed = true;
		if (var->gui.watermark_spawn_alpha > 0.001f)  watermark->render();
		if (var->gui.active_hotkeys_spawn_alpha > 0.001f) keybinds->render();
		if (var->gui.playerbar_spawn_alpha > 0.001f)  playerbar->render();
		if (var->gui.spotify_spawn_alpha > 0.001f)    { musicplayer->update(); musicplayer->render(); }
		if (var->gui.playerlist_spawn_alpha > 0.001f) playerlist->render();
		return;
	}

	if (var->gui.menu_was_closed)
	{
		var->gui.menu_open_alpha = 0.0f;
		var->gui.menu_was_closed = false;
	}

	try
	{
		gui->easing(var->gui.menu_open_alpha, 1.0f, 6.0f, dynamic_easing);

		float scale_progress = var->gui.menu_open_alpha;
		scale_progress = scale_progress * scale_progress;
		float menu_scale = 0.85f + (scale_progress * 0.15f);

		// Load pattern texture if not loaded yet
		static bool pattern_loaded = false;
		static bool pattern_load_attempted = false;
		if (!pattern_load_attempted)
		{
			try {
				LoadPatternTexture();
				pattern_loaded = true;
			}
			catch (...) {
				// Pattern loading failed, continue without pattern
				pattern_loaded = false;
			}
			pattern_load_attempted = true;
		}

		gui->initialize();
		gui->set_next_window_size(SCALE(elements->window.size));
		gui->begin(elements->window.name, nullptr, window_flags_no_scrollbar | window_flags_no_scroll_with_mouse | window_flags_no_bring_to_front_on_focus | window_flags_no_focus_on_appearing | window_flags_no_background | window_flags_no_decoration);
		{
			c_window* window = gui->get_window();
			c_vec2 pos = window->Pos;
			c_vec2 size = window->Size;

			var->gui.menu_rect_min = ImVec2(pos.x, pos.y);
			var->gui.menu_rect_size = ImVec2(size.x, size.y);
			var->gui.menu_rect_valid = true;

			ImVec2 menu_center = ImVec2(pos.x + size.x * 0.5f, pos.y + size.y * 0.5f);
			ImVec2 scaled_pos = ImVec2(
				menu_center.x + (pos.x - menu_center.x) * menu_scale,
				menu_center.y + (pos.y - menu_center.y) * menu_scale
			);
			ImVec2 scaled_size = ImVec2(size.x * menu_scale, size.y * menu_scale);

			c_rect rect = c_rect(scaled_pos, scaled_pos + scaled_size);
			c_draw_list* draw_list = gui->background_drawlist();

			float menu_shadow_blur = SCALE(12.0f);
			for (int s = 0; s < 6; s++)
			{
				float progress = (float)s / 6.0f;
				float alpha = (1.0f - progress) * 0.35f * var->gui.menu_open_alpha;
				float blur_amount = menu_shadow_blur * progress;
				ImVec2 shadow_min = ImVec2(scaled_pos.x - blur_amount, scaled_pos.y - blur_amount);
				ImVec2 shadow_max = ImVec2(scaled_pos.x + scaled_size.x + blur_amount, scaled_pos.y + scaled_size.y + blur_amount);

				draw_list->AddRectFilled(
					shadow_min,
					shadow_max,
					IM_COL32(0, 0, 0, (int)(alpha * 255)),
					SCALE(elements->window.rounding) + blur_amount
				);
			}

			draw_list->PushClipRect(scaled_pos, ImVec2(scaled_pos.x + scaled_size.x, scaled_pos.y + scaled_size.y), true);

			ImVec4 bg_top = ImVec4(34.0f / 255.0f, 36.0f / 255.0f, 41.0f / 255.0f, 0.52f * var->gui.menu_open_alpha);
			ImVec4 bg_bottom = ImVec4(14.0f / 255.0f, 15.0f / 255.0f, 18.0f / 255.0f, 0.58f * var->gui.menu_open_alpha);

			draw_list->AddRectFilled(
				scaled_pos,
				ImVec2(scaled_pos.x + scaled_size.x, scaled_pos.y + scaled_size.y),
				draw->get_clr(bg_bottom),
				SCALE(elements->window.rounding)
			);

			draw_list->AddRectFilledMultiColor(
				scaled_pos,
				ImVec2(scaled_pos.x + scaled_size.x, scaled_pos.y + scaled_size.y),
				draw->get_clr(bg_top),
				draw->get_clr(bg_top),
				draw->get_clr(bg_bottom),
				draw->get_clr(bg_bottom)
			);

			// aurora wash - blue and lilac blooms drifting under the glass
			{
				const float t = (float)ImGui::GetTime();
				const float fade = var->gui.menu_open_alpha;

				struct blob_t { float ox, oy, ax, ay, spd, phase, rad, a; int r, g, b; };
				static const blob_t blobs[] = {
					{ 0.22f, 0.26f, 0.13f, 0.09f, 0.17f, 0.0f, 0.68f, 0.55f, 143, 200, 255 },
					{ 0.80f, 0.30f, 0.11f, 0.11f, 0.13f, 2.2f, 0.74f, 0.46f, 201, 168, 255 },
					{ 0.56f, 0.78f, 0.15f, 0.10f, 0.10f, 4.1f, 0.70f, 0.40f, 143, 200, 255 },
					{ 0.30f, 0.64f, 0.12f, 0.13f, 0.15f, 5.6f, 0.58f, 0.36f, 201, 168, 255 }
				};

				const int rings = 14;
				float ring_norm = 0.0f;
				for (int k = 1; k <= rings; k++)
					ring_norm += (1.0f - (float)(k - 1) / rings);

				for (const auto& bl : blobs)
				{
					const ImVec2 c = ImVec2(
						scaled_pos.x + scaled_size.x * (bl.ox + sinf(t * bl.spd + bl.phase) * bl.ax),
						scaled_pos.y + scaled_size.y * (bl.oy + cosf(t * bl.spd * 0.87f + bl.phase) * bl.ay));
					const float r = bl.rad * scaled_size.x;
					const float base = (bl.a * fade) / ring_norm;

					for (int k = rings; k >= 1; k--)
					{
						const int a = (int)(base * (1.0f - (float)(k - 1) / rings) * 255.0f);
						if (a < 1)
							continue;

						draw_list->AddCircleFilled(c, r * ((float)k / rings),
							IM_COL32(bl.r, bl.g, bl.b, a), 48);
					}
				}

				draw_list->AddRectFilledMultiColor(
					scaled_pos,
					ImVec2(scaled_pos.x + scaled_size.x, scaled_pos.y + scaled_size.y),
					IM_COL32(10, 11, 14, (int)(30 * fade)),
					IM_COL32(10, 11, 14, (int)(30 * fade)),
					IM_COL32(6, 7, 9, (int)(54 * fade)),
					IM_COL32(6, 7, 9, (int)(54 * fade)));

				const ImVec2 v0 = scaled_pos;
				const ImVec2 v1 = ImVec2(scaled_pos.x + scaled_size.x, scaled_pos.y + scaled_size.y);
				const float vw = scaled_size.x * 0.17f;
				const float vh = scaled_size.y * 0.17f;
				const int va = (int)(66 * fade);

				draw_list->AddRectFilledMultiColor(
					ImVec2(v0.x, v0.y), ImVec2(v1.x, v0.y + vh),
					IM_COL32(4, 5, 7, va), IM_COL32(4, 5, 7, va),
					IM_COL32(4, 5, 7, 0), IM_COL32(4, 5, 7, 0));
				draw_list->AddRectFilledMultiColor(
					ImVec2(v0.x, v1.y - vh), ImVec2(v1.x, v1.y),
					IM_COL32(4, 5, 7, 0), IM_COL32(4, 5, 7, 0),
					IM_COL32(4, 5, 7, va), IM_COL32(4, 5, 7, va));
				draw_list->AddRectFilledMultiColor(
					ImVec2(v0.x, v0.y), ImVec2(v0.x + vw, v1.y),
					IM_COL32(4, 5, 7, va), IM_COL32(4, 5, 7, 0),
					IM_COL32(4, 5, 7, 0), IM_COL32(4, 5, 7, va));
				draw_list->AddRectFilledMultiColor(
					ImVec2(v1.x - vw, v0.y), ImVec2(v1.x, v1.y),
					IM_COL32(4, 5, 7, 0), IM_COL32(4, 5, 7, va),
					IM_COL32(4, 5, 7, va), IM_COL32(4, 5, 7, 0));
			}

			{
				int gw = 0, gh = 0;
				ID3D11ShaderResourceView* grain = GetGrainTexture(&gw, &gh);
				if (grain)
				{
					const float gr = SCALE(elements->window.rounding);
					draw_list->AddImage((ImTextureID)grain,
						ImVec2(scaled_pos.x + gr, scaled_pos.y + gr),
						ImVec2(scaled_pos.x + scaled_size.x - gr, scaled_pos.y + scaled_size.y - gr),
						ImVec2(0.0f, 0.0f), ImVec2(1.0f, 1.0f),
						IM_COL32(255, 255, 255, (int)(255 * var->gui.menu_open_alpha)));
				}
			}

			{
				const float br = SCALE(elements->window.rounding);
				const int bounce = (int)(34 * var->gui.menu_open_alpha);
				draw_list->AddRectFilledMultiColor(
					ImVec2(scaled_pos.x + br, scaled_pos.y + scaled_size.y - SCALE(7.0f)),
					ImVec2(scaled_pos.x + scaled_size.x - br, scaled_pos.y + scaled_size.y - SCALE(1.0f)),
					IM_COL32(143, 200, 255, 0), IM_COL32(143, 200, 255, 0),
					IM_COL32(143, 200, 255, bounce), IM_COL32(143, 200, 255, bounce));
			}

			draw_list->PopClipRect();

			ImGui::PushStyleVar(ImGuiStyleVar_Alpha, var->gui.menu_open_alpha);

			float tabbar_height = SCALE(45.0f);
			ImVec2 tabbar_start = scaled_pos;
			ImVec2 tabbar_end = ImVec2(scaled_pos.x + scaled_size.x, scaled_pos.y + tabbar_height);

			draw_list->PushClipRect(tabbar_start, tabbar_end, true);

			ImVec4 tabbar_top = ImVec4(66.0f / 255.0f, 68.0f / 255.0f, 72.0f / 255.0f, 0.68f);
			ImVec4 tabbar_bottom = ImVec4(58.0f / 255.0f, 60.0f / 255.0f, 64.0f / 255.0f, 0.68f);

			draw_list->AddRectFilled(
				tabbar_start,
				tabbar_end,
				draw->get_clr(tabbar_bottom),
				SCALE(elements->window.rounding),
				ImDrawFlags_RoundCornersTop
			);

			draw_list->AddRectFilledMultiColor(
				tabbar_start,
				tabbar_end,
				draw->get_clr(tabbar_top),
				draw->get_clr(tabbar_top),
				draw->get_clr(tabbar_bottom),
				draw->get_clr(tabbar_bottom)
			);

			{
				const float tr = SCALE(elements->window.rounding);
				const int sheen = (int)(72 * var->gui.menu_open_alpha);
				draw_list->AddRectFilledMultiColor(
					ImVec2(tabbar_start.x + tr, tabbar_start.y),
					ImVec2(tabbar_end.x - tr, tabbar_start.y + SCALE(2.5f)),
					IM_COL32(255, 255, 255, sheen), IM_COL32(255, 255, 255, sheen),
					IM_COL32(255, 255, 255, 0), IM_COL32(255, 255, 255, 0));
			}

			draw_list->PopClipRect();

			// base outline + a light runner chasing the perimeter
			{
				const float fade = var->gui.menu_open_alpha;
				const ImVec2 b0 = scaled_pos;
				const ImVec2 b1 = ImVec2(scaled_pos.x + scaled_size.x, scaled_pos.y + scaled_size.y);
				const float R = SCALE(elements->window.rounding);
				const float bw = SCALE(2.5f);
				const int slices = 6;

				draw_list->AddRect(b0, b1,
					IM_COL32(143, 200, 255, (int)(44 * fade)), R, 0, SCALE(1.5f));

				const float p = fmodf((float)ImGui::GetTime() * 0.38f, 4.0f);

				auto runner = [&](float g)
				{
					float d = fmodf(g - p + 4.0f, 4.0f);
					if (d > 2.0f) d = 4.0f - d;
					return expf(-(d * d) / 0.016f);
				};

				auto band_col = [&](float g)
				{
					const float a = (0.11f + 0.80f * g) * fade;
					const float w = 0.60f * g;
					return IM_COL32(
						(int)(143 + (238 - 143) * w),
						(int)(200 + (250 - 200) * w),
						255,
						(int)(a * 255));
				};

				auto horiz = [&](float y, float x0, float x1, float g_offset, bool reversed)
				{
					const float span = x1 - x0;
					for (int i = 0; i < slices; i++)
					{
						const float u0 = (float)i / slices;
						const float u1 = (float)(i + 1) / slices;
						const float g0 = runner(reversed ? (g_offset + 1.0f - u0) : (g_offset + u0));
						const float g1 = runner(reversed ? (g_offset + 1.0f - u1) : (g_offset + u1));
						draw_list->AddRectFilledMultiColor(
							ImVec2(x0 + span * u0, y), ImVec2(x0 + span * u1, y + bw),
							band_col(g0), band_col(g1), band_col(g1), band_col(g0));
					}
				};

				auto vert = [&](float x, float y0, float y1, float g_offset, bool reversed)
				{
					const float span = y1 - y0;
					for (int i = 0; i < slices; i++)
					{
						const float u0 = (float)i / slices;
						const float u1 = (float)(i + 1) / slices;
						const float g0 = runner(reversed ? (g_offset + 1.0f - u0) : (g_offset + u0));
						const float g1 = runner(reversed ? (g_offset + 1.0f - u1) : (g_offset + u1));
						draw_list->AddRectFilledMultiColor(
							ImVec2(x, y0 + span * u0), ImVec2(x + bw, y0 + span * u1),
							band_col(g0), band_col(g0), band_col(g1), band_col(g1));
					}
				};

				horiz(b0.y, b0.x + R, b1.x - R, 0.0f, false);
				vert(b1.x - bw, b0.y + R, b1.y - R, 1.0f, false);
				horiz(b1.y - bw, b0.x + R, b1.x - R, 2.0f, true);
				vert(b0.x, b0.y + R, b1.y - R, 3.0f, true);
			}

			{
				const char* logo_text = "Vade";
				ImFont* logo_font = font->get(main_font_data, 18.0f);
				if (logo_font)
				{
					ImVec2 logo_size = logo_font->CalcTextSizeA(18.0f, FLT_MAX, 0.0f, logo_text);
					ImVec2 logo_pos = ImVec2(
						tabbar_start.x + SCALE(20.0f),
						tabbar_start.y + (tabbar_height - logo_size.y) * 0.5f
					);

					for (int g = 10; g > 0; g--)
					{
						float glow_alpha = (g / 10.0f) * 0.4f * var->gui.menu_open_alpha;
						float glow_offset = SCALE(g * 0.8f);

						draw_list->AddText(logo_font, 18.0f,
							ImVec2(logo_pos.x, logo_pos.y),
							IM_COL32(143, 200, 255, (int)(glow_alpha * 255)),
							logo_text);
					}

					draw_list->AddText(logo_font, 18.0f,
						ImVec2(logo_pos.x + SCALE(1.0f), logo_pos.y + SCALE(1.0f)),
						IM_COL32(0, 0, 0, (int)(100 * var->gui.menu_open_alpha)),
						logo_text);

					draw_list->AddText(logo_font, 18.0f, logo_pos,
						draw->get_clr(ImVec4(143.0f / 255.0f, 200.0f / 255.0f, 255.0f / 255.0f, var->gui.menu_open_alpha)),
						logo_text);

					draw_list->PushClipRect(logo_pos, ImVec2(logo_pos.x + logo_size.x, logo_pos.y + logo_size.y * 0.3f), true);
					draw_list->AddText(logo_font, 18.0f, logo_pos,
						draw->get_clr(ImVec4(240.0f / 255.0f, 250.0f / 255.0f, 255.0f / 255.0f, 0.6f * var->gui.menu_open_alpha)),
						logo_text);
					draw_list->PopClipRect();

					// active tab name beside the logo, slides in on switch
					static const char* tab_names[] = {
						"aimbot", "visuals", "misc", "config", "colors", "settings", "music"
					};
					static int last_label_tab = -1;
					static float label_alpha = 1.0f;

					if (last_label_tab != var->gui.active_tab)
					{
						if (last_label_tab >= 0)
							label_alpha = 0.0f;
						last_label_tab = var->gui.active_tab;
					}
					gui->easing(label_alpha, 1.0f, 8.0f, dynamic_easing);

					ImFont* label_font = font->get(main_font_data, 14.0f);
					const char* label_text = tab_names[var->gui.active_tab];

					if (label_font && label_alpha > 0.01f)
					{
						const float a = label_alpha * var->gui.menu_open_alpha;
						const ImVec2 lsz = label_font->CalcTextSizeA(14.0f, FLT_MAX, 0.0f, label_text);
						const float divider_x = logo_pos.x + logo_size.x + SCALE(14.0f);
						const float text_x = divider_x + SCALE(14.0f) + (1.0f - label_alpha) * SCALE(12.0f);

						draw_list->AddRectFilled(
							ImVec2(divider_x, tabbar_start.y + SCALE(13.0f)),
							ImVec2(divider_x + SCALE(1.0f), tabbar_start.y + tabbar_height - SCALE(13.0f)),
							IM_COL32(143, 200, 255, (int)(120 * a)));

						draw_list->AddText(label_font, 14.0f,
							ImVec2(text_x, tabbar_start.y + (tabbar_height - lsz.y) * 0.5f),
							IM_COL32(198, 222, 246, (int)(230 * a)),
							label_text);

						// small accent tick under the label
						draw_list->AddRectFilled(
							ImVec2(text_x, tabbar_start.y + tabbar_height - SCALE(6.0f)),
							ImVec2(text_x + lsz.x * label_alpha, tabbar_start.y + tabbar_height - SCALE(4.0f)),
							IM_COL32(143, 200, 255, (int)(170 * a)),
							SCALE(1.0f));
					}
				}
			}

			ImVec4 accent_color = ImVec4(143.0f / 255.0f, 200.0f / 255.0f, 255.0f / 255.0f, 1.0f);

			const char* tab_icons[] = {
				"\xEF\x80\x98",    // U+F018 - Aimbot
				"\xEF\x81\x8B",    // U+F04B - Visuals
				"\xEF\x80\x8C",    // U+F00C - Misc
				"\xEF\x80\xAF",    // U+F02F - Configs
				"\xEF\x81\x94",    // U+F054 - Colors
				"\xEF\x80\x8D",    // U+F00D - Settings
				"\xEF\x80\x81"     // U+F001 - Music
			};
			int tab_count = 7;

			float box_size = SCALE(32.0f);
			float tab_spacing = SCALE(8.0f);
			float total_tabs_width = (tab_count * box_size) + ((tab_count - 1) * tab_spacing);
			float tabs_start_x = scaled_pos.x + scaled_size.x - total_tabs_width - SCALE(15.0f);

			ImFont* tab_icon_font = font->get(main_font_data, 16.0f);

			if (tab_icon_font)
			{
				for (int i = 0; i < tab_count; i++)
				{
					float tab_x = tabs_start_x + (i * (box_size + tab_spacing));

					ImVec2 box_pos = ImVec2(tab_x, scaled_pos.y + (tabbar_height - box_size) / 2.0f);
					ImVec2 box_end = ImVec2(box_pos.x + box_size, box_pos.y + box_size);

					// Hit detection
					c_rect tab_rect = c_rect(box_pos, box_end);

					bool hovered = IsMouseHoveringRect(tab_rect.Min, tab_rect.Max, false);
					bool clicked = hovered && gui->mouse_clicked(0, false);

					if (clicked)
					{
						if (var->gui.active_tab != i)
						{
							var->gui.active_tab = i;
							var->gui.tab_transition_alpha = 0.0f;
						}
					}

					bool is_active = (i == var->gui.active_tab);

					// per-tab hover / selection easing
					static float tab_hover[7] = { 0.0f };
					static float tab_sel[7] = { 0.0f };
					gui->easing(tab_hover[i], hovered ? 1.0f : 0.0f, 9.0f, dynamic_easing);
					gui->easing(tab_sel[i], is_active ? 1.0f : 0.0f, 9.0f, dynamic_easing);

					const float sel = tab_sel[i];
					const float hov = tab_hover[i];
					const float idle = 1.0f - sel;

					// accent bloom behind the plate
					if (sel > 0.01f)
					{
						draw_list->AddRectFilled(
							ImVec2(box_pos.x - SCALE(6.0f), box_pos.y - SCALE(6.0f)),
							ImVec2(box_end.x + SCALE(6.0f), box_end.y + SCALE(6.0f)),
							IM_COL32(143, 200, 255, (int)(22 * sel)),
							SCALE(13.0f));

						draw_list->AddRectFilled(
							ImVec2(box_pos.x - SCALE(3.0f), box_pos.y - SCALE(3.0f)),
							ImVec2(box_end.x + SCALE(3.0f), box_end.y + SCALE(3.0f)),
							IM_COL32(143, 200, 255, (int)(50 * sel)),
							SCALE(9.0f));
					}

					// frosted glass plate: cool translucent body, denser when active
					{
						const float hov_a = hov * idle;

						if (sel > 0.01f || hov_a > 0.01f)
						{
							draw->rect_filled_multi_color(draw_list, box_pos, box_end,
								IM_COL32(255, 255, 255, (int)(38 + 76 * sel + 34 * hov_a)),
								IM_COL32(255, 255, 255, (int)(30 + 64 * sel + 28 * hov_a)),
								IM_COL32(143, 200, 255, (int)(52 + 46 * sel + 30 * hov_a)),
								IM_COL32(143, 200, 255, (int)(44 + 40 * sel + 26 * hov_a)),
								SCALE(6.0f));
						}

						const int hl = (int)(116 * sel + 56 * hov_a);
						if (hl > 0)
						{
							draw_list->AddRectFilled(
								ImVec2(box_pos.x + SCALE(2.0f), box_pos.y + SCALE(2.0f)),
								ImVec2(box_end.x - SCALE(2.0f), box_pos.y + SCALE(3.5f)),
								IM_COL32(255, 255, 255, hl),
								SCALE(1.0f));
						}
					}

					// plate border
					draw_list->AddRect(box_pos, box_end,
						IM_COL32(
							(int)(143 + (214 - 143) * sel),
							(int)(200 + (238 - 200) * sel),
							255,
							(int)(48 + 118 * sel + 52 * hov * idle)),
						SCALE(6.0f), 0, SCALE(1.0f));

					gui->push_font(tab_icon_font);

					ImVec2 icon_size = ImGui::CalcTextSize(tab_icons[i]);

					ImVec2 centered_icon_pos = ImVec2(
						box_pos.x + (box_size - icon_size.x) * 0.5f,
						box_pos.y + (box_size - icon_size.y) * 0.5f + SCALE(1.0f)
					);

					const float m = hov * idle;
					ImU32 icon_col = IM_COL32(
						(int)(120 + (176 - 120) * m + (14 - 120) * sel),
						(int)(120 + (220 - 120) * m + (26 - 120) * sel),
						(int)(125 + (255 - 125) * m + (40 - 125) * sel),
						255);

					if (sel > 0.02f)
					{
						draw_list->AddText(tab_icon_font, 16.0f,
							ImVec2(centered_icon_pos.x, centered_icon_pos.y + SCALE(1.0f)),
							IM_COL32(10, 22, 36, (int)(66 * sel)),
							tab_icons[i]);
					}

					draw_list->AddText(tab_icon_font, 16.0f, centered_icon_pos, icon_col, tab_icons[i]);

					gui->pop_font();
				}

				// sliding selection rail under the active tab
				{
					static float rail_x = -1.0f;
					const float rail_target = tabs_start_x + var->gui.active_tab * (box_size + tab_spacing);
					if (rail_x < -0.5f)
						rail_x = rail_target;
					gui->easing(rail_x, rail_target, 13.0f, dynamic_easing);

					const float rail_y = scaled_pos.y + (tabbar_height + box_size) * 0.5f + SCALE(2.0f);

					draw_list->AddRectFilled(
						ImVec2(rail_x - SCALE(5.0f), rail_y - SCALE(3.5f)),
						ImVec2(rail_x + box_size + SCALE(5.0f), rail_y + SCALE(4.5f)),
						IM_COL32(143, 200, 255, 40),
						SCALE(4.0f));

					draw_list->AddRectFilled(
						ImVec2(rail_x, rail_y),
						ImVec2(rail_x + box_size, rail_y + SCALE(2.5f)),
						IM_COL32(143, 200, 255, 235),
						SCALE(1.5f));
				}
			}

			float shadow_total_height = SCALE(20.0f);
			int shadow_layers = 12;

			for (int i = 0; i < shadow_layers; i++)
			{
				float layer_progress = (float)i / (float)shadow_layers;
				float next_progress = (float)(i + 1) / (float)shadow_layers;

				float alpha_start = (1.0f - layer_progress) * (1.0f - layer_progress) * 0.6f * var->gui.menu_open_alpha;
				float alpha_end = (1.0f - next_progress) * (1.0f - next_progress) * 0.6f * var->gui.menu_open_alpha;

				ImVec2 layer_start = ImVec2(scaled_pos.x, scaled_pos.y + tabbar_height + (shadow_total_height * layer_progress));
				ImVec2 layer_end = ImVec2(scaled_pos.x + scaled_size.x, scaled_pos.y + tabbar_height + (shadow_total_height * next_progress));

				draw_list->AddRectFilledMultiColor(
					layer_start,
					layer_end,
					draw->get_clr(ImVec4(0.0f, 0.0f, 0.0f, alpha_start)),
					draw->get_clr(ImVec4(0.0f, 0.0f, 0.0f, alpha_start)),
					draw->get_clr(ImVec4(0.0f, 0.0f, 0.0f, alpha_end)),
					draw->get_clr(ImVec4(0.0f, 0.0f, 0.0f, alpha_end))
				);
			}

			float content_padding = SCALE(20.0f);
			float content_y = scaled_pos.y + tabbar_height + SCALE(25.0f);
			ImVec2 content_pos = ImVec2(scaled_pos.x + content_padding, content_y);
			float content_width = scaled_size.x - (content_padding * 2);
			float content_height = scaled_size.y - tabbar_height - SCALE(25.0f) - content_padding;

			gui->easing(var->gui.tab_transition_alpha, 1.0f, 6.0f, dynamic_easing);  // Smooth fade

			float child_spacing = SCALE(15.0f);
			float child_width = (content_width - child_spacing) / 2.0f;
			float child_height = (content_height - child_spacing) / 2.0f;

			ImVec4 child_bg_top = ImVec4(76.0f / 255.0f, 78.0f / 255.0f, 82.0f / 255.0f, 0.55f);
			ImVec4 child_bg_bottom = ImVec4(46.0f / 255.0f, 48.0f / 255.0f, 52.0f / 255.0f, 0.55f);

			ImVec4 child_header_top = ImVec4(72.0f / 255.0f, 74.0f / 255.0f, 78.0f / 255.0f, 0.78f);
			ImVec4 child_header_bottom = ImVec4(60.0f / 255.0f, 62.0f / 255.0f, 66.0f / 255.0f, 0.78f);

			const char* child_titles[7][4] = {
				// Tab 0: Aimbot
				{ "targeting", "smoothing", "recoil", "triggerbot" },
				// Tab 1: Visuals
				{ "esp", "chams", "glow", "radar" },
				// Tab 2: Misc
				{ "movement", "automation", "exploits", "utilities" },
		// Tab 3: Config
		{ "profiles", "preferences", "manage", "overlays" },
				// Tab 4: Colors
				{ "colors", "", "", "" },
				// Tab 5: Settings
				{ "settings", "", "", "" },
				// Tab 6: Music
				{ "music", "", "", "" }
			};

			float child_header_height = SCALE(40.0f);
			ImFont* child_title_font = font->get(main_font_data, 15.0f);

			// meta line - right side of every child panel header
			auto header_meta = [&](const ImVec2& hmin, const ImVec2& hmax, float alpha, const char* mtext)
			{
				ImFont* mf = font->get(main_font_data, 11.0f);
				if (!mf || alpha <= 0.01f || !mtext || !mtext[0])
					return;

				ImVec2 msz = mf->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, mtext);
				draw_list->AddText(mf, 11.0f,
					ImVec2(hmax.x - SCALE(15.0f) - msz.x, hmin.y + (child_header_height - msz.y) * 0.5f),
					IM_COL32(150, 155, 165, (int)(150 * alpha)),
					mtext);
			};

			// accent marker + hairline under every child panel header
			auto header_accent = [&](const ImVec2& hmin, const ImVec2& hmax, const char* htitle, float alpha)
			{
				if (!child_title_font || alpha <= 0.01f || !htitle)
					return;

				const ImVec2 tsize = child_title_font->CalcTextSizeA(15.0f, FLT_MAX, 0.0f, htitle);
				const float cy = hmin.y + (child_header_height - tsize.y) * 0.5f;

				draw_list->AddRectFilled(
					ImVec2(hmin.x + SCALE(6.0f), cy - SCALE(5.0f)),
					ImVec2(hmin.x + SCALE(15.0f), cy + tsize.y + SCALE(5.0f)),
					IM_COL32(143, 200, 255, (int)(55 * alpha)),
					SCALE(3.0f));

				draw_list->AddRectFilled(
					ImVec2(hmin.x + SCALE(9.0f), cy - SCALE(2.0f)),
					ImVec2(hmin.x + SCALE(12.0f), cy + tsize.y + SCALE(2.0f)),
					IM_COL32(143, 200, 255, (int)(235 * alpha)),
					SCALE(1.5f));

				draw_list->AddRectFilledMultiColor(
					ImVec2(hmin.x, hmax.y - SCALE(1.0f)),
					ImVec2(hmax.x, hmax.y),
					IM_COL32(143, 200, 255, (int)(105 * alpha)),
					IM_COL32(143, 200, 255, 0),
					IM_COL32(143, 200, 255, 0),
					IM_COL32(143, 200, 255, (int)(105 * alpha)));
			};

			if (var->gui.active_tab == 5 || var->gui.active_tab == 6)
			{
				float large_child_width = content_width;
				float large_child_height = content_height;

				ImVec2 child_pos = content_pos;
				ImVec2 child_end = ImVec2(child_pos.x + large_child_width, child_pos.y + large_child_height);

				float scale_progress = var->gui.tab_transition_alpha;
				scale_progress = scale_progress * scale_progress;
				float scale_effect = 0.85f + (scale_progress * 0.15f);

				ImVec2 center = ImVec2((child_pos.x + child_end.x) * 0.5f, (child_pos.y + child_end.y) * 0.5f);
				ImVec2 scaled_min = ImVec2(
					center.x + (child_pos.x - center.x) * scale_effect,
					center.y + (child_pos.y - center.y) * scale_effect
				);
				ImVec2 scaled_max = ImVec2(
					center.x + (child_end.x - center.x) * scale_effect,
					center.y + (child_end.y - center.y) * scale_effect
				);

				float shadow_blur = SCALE(8.0f);
				for (int s = 0; s < 5; s++)
				{
					float progress = (float)s / 5.0f;
					float alpha = (1.0f - progress) * 0.25f * var->gui.tab_transition_alpha;
					float blur_amount = shadow_blur * progress;

					ImVec2 shadow_min = ImVec2(scaled_min.x - blur_amount, scaled_min.y - blur_amount);
					ImVec2 shadow_max = ImVec2(scaled_max.x + blur_amount, scaled_max.y + blur_amount);

					draw_list->AddRectFilled(shadow_min, shadow_max, IM_COL32(0, 0, 0, (int)(alpha * 255)), SCALE(8.0f + blur_amount));
				}

				ImVec4 animated_child_bg_top = child_bg_top;
				ImVec4 animated_child_bg_bottom = child_bg_bottom;
				animated_child_bg_top.w *= var->gui.tab_transition_alpha;
				animated_child_bg_bottom.w *= var->gui.tab_transition_alpha;

				draw_list->PushClipRect(scaled_min, scaled_max, true);

				draw_list->AddRectFilled(
					scaled_min,
					scaled_max,
					draw->get_clr(animated_child_bg_bottom),
					SCALE(8.0f)
				);

				draw_list->AddRectFilledMultiColor(
					scaled_min,
					scaled_max,
					draw->get_clr(animated_child_bg_top),
					draw->get_clr(animated_child_bg_top),
					draw->get_clr(animated_child_bg_bottom),
					draw->get_clr(animated_child_bg_bottom)
				);

				{
					const float panel_a = var->gui.tab_transition_alpha;
					draw_list->AddRectFilledMultiColor(
						ImVec2(scaled_min.x + SCALE(8.0f), scaled_min.y),
						ImVec2(scaled_max.x - SCALE(8.0f), scaled_min.y + SCALE(2.5f)),
						IM_COL32(255, 255, 255, (int)(76 * panel_a)), IM_COL32(255, 255, 255, (int)(76 * panel_a)),
						IM_COL32(255, 255, 255, 0), IM_COL32(255, 255, 255, 0));
					draw_list->AddRect(scaled_min, scaled_max,
						IM_COL32(255, 255, 255, (int)(20 * panel_a)),
						SCALE(8.0f), 0, SCALE(1.0f));
				}

				draw_list->PopClipRect();

				// Header
				ImVec2 header_start = scaled_min;
				ImVec2 header_end = ImVec2(scaled_max.x, scaled_min.y + child_header_height);

				ImVec4 animated_header_top = child_header_top;
				ImVec4 animated_header_bottom = child_header_bottom;
				animated_header_top.w *= var->gui.tab_transition_alpha;
				animated_header_bottom.w *= var->gui.tab_transition_alpha;

				draw_list->PushClipRect(header_start, header_end, true);

				draw_list->AddRectFilled(
					header_start,
					header_end,
					draw->get_clr(animated_header_bottom),
					SCALE(8.0f),
					ImDrawFlags_RoundCornersTop
				);

				draw_list->AddRectFilledMultiColor(
					header_start,
					header_end,
					draw->get_clr(animated_header_top),
					draw->get_clr(animated_header_top),
					draw->get_clr(animated_header_bottom),
					draw->get_clr(animated_header_bottom)
				);

				draw_list->PopClipRect();

				if (child_title_font)
				{
					gui->push_font(child_title_font);
					const char* title = (var->gui.active_tab == 6) ? child_titles[6][0] : "settings";
					header_accent(scaled_min, ImVec2(scaled_max.x, scaled_min.y + child_header_height), title, var->gui.tab_transition_alpha);
					ImVec2 title_size = ImGui::CalcTextSize(title);
					ImVec2 title_pos = ImVec2(scaled_min.x + SCALE(15.0f), scaled_min.y + (child_header_height - title_size.y) * 0.5f);

					ImVec4 animated_accent = accent_color;
					animated_accent.w *= var->gui.tab_transition_alpha;
					draw_header_title(draw_list, child_title_font, 15.0f, title_pos, draw->get_clr(animated_accent), title, SCALE(1.5f));
					gui->pop_font();
					header_meta(scaled_min, ImVec2(scaled_max.x, scaled_min.y + child_header_height), var->gui.tab_transition_alpha,
						(var->gui.active_tab == 6) ? "library" : "preferences");
				}

				float bottom_shadow_height = SCALE(10.0f);
				for (int bs = 0; bs < 5; bs++)
				{
					float bs_progress = (float)bs / 5.0f;
					float bs_alpha = (1.0f - bs_progress) * 0.35f * var->gui.tab_transition_alpha;

					ImVec2 bs_start = ImVec2(scaled_min.x, header_end.y + (bottom_shadow_height * bs_progress));
					ImVec2 bs_end = ImVec2(scaled_max.x, header_end.y + (bottom_shadow_height * (bs_progress + 0.2f)));

					draw_list->AddRectFilledMultiColor(bs_start, bs_end,
						IM_COL32(0, 0, 0, (int)(bs_alpha * 255)), IM_COL32(0, 0, 0, (int)(bs_alpha * 255)),
						IM_COL32(0, 0, 0, 0), IM_COL32(0, 0, 0, 0));
				}

				// Clipping
				draw_list->PushClipRect(scaled_min, scaled_max, true);

				// Content area
				float content_start_y = child_pos.y + child_header_height + SCALE(15.0f);
				float content_area_height = large_child_height - child_header_height - SCALE(20.0f);
				ImVec2 child_content_pos = ImVec2(child_pos.x, content_start_y);
				ImVec2 child_content_size = ImVec2(large_child_width, content_area_height);

				float scale_offset_x = scaled_min.x - child_pos.x;
				float scale_offset_y = scaled_min.y - child_pos.y;

				ImGui::SetCursorPos(ImVec2(child_content_pos.x - pos.x + scale_offset_x, child_content_pos.y - pos.y + scale_offset_y));

				ImGui::PushStyleVar(ImGuiStyleVar_Alpha, var->gui.tab_transition_alpha);

				ImGui::BeginChild("##child_settings", child_content_size, false, ImGuiWindowFlags_NoBackground);

				if (var->gui.active_tab == 6)
				{
					// Music tab - Deezer browser
					render_deezer_tab(child_content_size.x, child_content_size.y);
				}
				else
				{
				// Padding
				ImGui::SetCursorPosX(SCALE(12.0f));

				// UI Element Toggles
				widgets->checkbox("show playerlist", &var->gui.show_playerlist);
				ImGui::SetCursorPosY(ImGui::GetCursorPosY() + SCALE(4.0f));

				ImGui::SetCursorPosX(SCALE(12.0f));
				widgets->checkbox("show playerbar", &var->gui.show_playerbar);
				ImGui::SetCursorPosY(ImGui::GetCursorPosY() + SCALE(4.0f));

				ImGui::SetCursorPosX(SCALE(12.0f));
				widgets->checkbox("show spotify player", &var->gui.show_spotify);
				ImGui::SetCursorPosY(ImGui::GetCursorPosY() + SCALE(4.0f));

				ImGui::SetCursorPosX(SCALE(12.0f));
				widgets->checkbox("show active hotkeys", &var->gui.show_active_hotkeys);
				ImGui::SetCursorPosY(ImGui::GetCursorPosY() + SCALE(4.0f));

				ImGui::SetCursorPosX(SCALE(12.0f));
				widgets->checkbox("show watermark", &var->gui.show_watermark);
				}

				ImGui::EndChild();

				ImGui::PopStyleVar();  // Alpha

				draw_list->PopClipRect();
			}
			else if (var->gui.active_tab == 4)
			{
				float large_child_width = content_width;
				float large_child_height = content_height;

				ImVec2 child_pos = content_pos;
				ImVec2 child_end = ImVec2(child_pos.x + large_child_width, child_pos.y + large_child_height);

				float scale_progress = var->gui.tab_transition_alpha;
				scale_progress = scale_progress * scale_progress;
				float scale_effect = 0.85f + (scale_progress * 0.15f);

				ImVec2 center = ImVec2((child_pos.x + child_end.x) * 0.5f, (child_pos.y + child_end.y) * 0.5f);
				ImVec2 scaled_min = ImVec2(
					center.x + (child_pos.x - center.x) * scale_effect,
					center.y + (child_pos.y - center.y) * scale_effect
				);
				ImVec2 scaled_max = ImVec2(
					center.x + (child_end.x - center.x) * scale_effect,
					center.y + (child_end.y - center.y) * scale_effect
				);

				float shadow_blur = SCALE(8.0f);
				for (int s = 0; s < 5; s++)
				{
					float progress = (float)s / 5.0f;
					float alpha = (1.0f - progress) * 0.25f * var->gui.tab_transition_alpha;
					float blur_amount = shadow_blur * progress;

					ImVec2 shadow_min = ImVec2(scaled_min.x - blur_amount, scaled_min.y - blur_amount);
					ImVec2 shadow_max = ImVec2(scaled_max.x + blur_amount, scaled_max.y + blur_amount);

					draw_list->AddRectFilled(shadow_min, shadow_max, IM_COL32(0, 0, 0, (int)(alpha * 255)), SCALE(8.0f + blur_amount));
				}

				ImVec4 animated_child_bg_top = child_bg_top;
				ImVec4 animated_child_bg_bottom = child_bg_bottom;
				animated_child_bg_top.w *= var->gui.tab_transition_alpha;
				animated_child_bg_bottom.w *= var->gui.tab_transition_alpha;

				draw_list->PushClipRect(scaled_min, scaled_max, true);

				draw_list->AddRectFilled(
					scaled_min,
					scaled_max,
					draw->get_clr(animated_child_bg_bottom),
					SCALE(8.0f)
				);

				draw_list->AddRectFilledMultiColor(
					scaled_min,
					scaled_max,
					draw->get_clr(animated_child_bg_top),
					draw->get_clr(animated_child_bg_top),
					draw->get_clr(animated_child_bg_bottom),
					draw->get_clr(animated_child_bg_bottom)
				);

				{
					const float panel_a = var->gui.tab_transition_alpha;
					draw_list->AddRectFilledMultiColor(
						ImVec2(scaled_min.x + SCALE(8.0f), scaled_min.y),
						ImVec2(scaled_max.x - SCALE(8.0f), scaled_min.y + SCALE(2.5f)),
						IM_COL32(255, 255, 255, (int)(76 * panel_a)), IM_COL32(255, 255, 255, (int)(76 * panel_a)),
						IM_COL32(255, 255, 255, 0), IM_COL32(255, 255, 255, 0));
					draw_list->AddRect(scaled_min, scaled_max,
						IM_COL32(255, 255, 255, (int)(20 * panel_a)),
						SCALE(8.0f), 0, SCALE(1.0f));
				}

				draw_list->PopClipRect();

				// Header
				ImVec2 header_start = scaled_min;
				ImVec2 header_end = ImVec2(scaled_max.x, scaled_min.y + child_header_height);

				ImVec4 animated_header_top = child_header_top;
				ImVec4 animated_header_bottom = child_header_bottom;
				animated_header_top.w *= var->gui.tab_transition_alpha;
				animated_header_bottom.w *= var->gui.tab_transition_alpha;

				draw_list->PushClipRect(header_start, header_end, true);

				draw_list->AddRectFilled(
