		{0.8f, 0.2f, 0.8f, 1.0f}, {0.2f, 0.8f, 0.8f, 1.0f}, {0.8f, 0.5f, 0.2f, 1.0f}, {0.5f, 0.2f, 0.8f, 1.0f}
	},
	{
