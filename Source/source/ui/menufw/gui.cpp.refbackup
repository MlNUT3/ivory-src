		{0.6f, 0.2f, 1.0f, 1.0f}, {1.0f, 0.2f, 0.2f, 0.5f}, {0.2f, 1.0f, 0.5f, 1.0f}, {1.0f, 1.0f, 1.0f, 1.0f},
