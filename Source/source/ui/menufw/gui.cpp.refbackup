static void draw_header_title(ImDrawList* dl, ImFont* font, float size, const ImVec2& pos, ImU32 col, const char* title, float tracking)
{
	char up[64];
	size_t n = 0;
	for (; title && title[n] && n + 1 < sizeof(up); n++)
		up[n] = (char)toupper((unsigned char)title[n]);
	up[n] = 0;

	float x = pos.x;
	for (const char* p = up; *p; ++p)
	{
		char one[2] = { *p, 0 };
		dl->AddText(font, size, ImVec2(x, pos.y), col, one);
		x += font->CalcTextSizeA(size, FLT_MAX, 0.0f, one).x + tracking;
	}
}

