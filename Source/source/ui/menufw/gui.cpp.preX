// ============================================================================
// overlays live outside the menu window so they work while closed.
// each widget self-gates on its spawn alpha - ease them here every frame.
// ============================================================================
static void overlays_tick() {
    // audio backend pumps here so playback + search workers advance
    // even while every overlay is hidden
    deezer->update();

    gui->easing(var->gui.playerlist_spawn_alpha,
        var->gui.show_playerlist ? 1.f : 0.f, 8.f, dynamic_easing);
    gui->easing(var->gui.playerbar_spawn_alpha,
        var->gui.show_playerbar ? 1.f : 0.f, 8.f, dynamic_easing);
    gui->easing(var->gui.spotify_spawn_alpha,
        (var->gui.show_spotify && settings::misc::spotify_window) ? 1.f : 0.f, 8.f, dynamic_easing);
    gui->easing(var->gui.active_hotkeys_spawn_alpha,
        settings::misc::keybind_list ? 1.f : 0.f, 8.f, dynamic_easing);
    gui->easing(var->gui.watermark_spawn_alpha,
        (var->gui.show_watermark && settings::misc::watermark) ? 1.f : 0.f, 8.f, dynamic_easing);

    watermark->render();
    keybinds->render();
    playerlist->render();
    playerbar->render();
    musicplayer->render();

    // soundcloud-backed search lives in the overlay layer next to
    // the now-playing widget, same visibility as the music overlay
    if (var->gui.show_spotify && settings::misc::spotify_window)
        render_deezer_tab(360.f, 440.f);
}

// ============================================================================
// menu chrome: theming, dust motes, section entrance, tab switching
// ============================================================================
static void theming_tick() {
    gui_style* st = &var->style;
    st->window_rounding = 8.f;
    st->child_rounding = 8.f;
    st->popup_rounding = 8.f;
    st->frame_rounding = 4.f;
    st->grab_rounding = 3.f;
    st->scrollbar_size = SCALE(5.f);
    st->scrollbar_rounding = 3.f;
    st->colors[style_col_scrollbar_bg] = ImVec4(0.05f, 0.05f, 0.06f, 0.60f);
    st->colors[style_col_scrollbar_grab] = ImVec4(0.698f, 0.612f, 1.0f, 0.32f);
    st->colors[style_col_scrollbar_grab_hovered] = ImVec4(0.698f, 0.612f, 1.0f, 0.55f);
    st->colors[style_col_scrollbar_grab_active] = ImVec4(0.698f, 0.612f, 1.0f, 0.80f);
}

struct dust_t { float x, y, sp, sz, ph; };

static void dust_tick(ImDrawList* dl, const ImVec2& wp, float ww, float wh) {
    static dust_t motes[26];
    static bool init = false;
    if (!init) {
        init = true;
        for (auto& m : motes) {
            m.x = (rand() % 1000) / 1000.f;
            m.y = (rand() % 1000) / 1000.f;
            m.sp = 0.010f + (rand() % 1000) / 1000.f * 0.025f;
            m.sz = 1.f + (rand() % 1000) / 1000.f * 1.5f;
            m.ph = (rand() % 1000) / 1000.f * 6.283f;
        }
    }
    const float t = (float)ImGui::GetTime();
    const float dt = ImGui::GetIO().DeltaTime;
    draw->push_clip_rect(dl, wp, ImVec2(wp.x + ww, wp.y + wh), true);
    for (auto& m : motes) {
        m.y -= m.sp * dt;
        if (m.y < 0.f) { m.y = 1.f; m.x = (rand() % 1000) / 1000.f; }
        const float tw = 0.35f + 0.65f * (0.5f + 0.5f * sinf(t * 1.7f + m.ph));
        const float sway = 0.018f * sinf(t * 0.6f + m.ph * 1.7f);
        dl->AddCircleFilled(ImVec2(wp.x + (m.x + sway) * ww, wp.y + m.y * wh), m.sz,
            IM_COL32(178, 156, 255, (int)(38 * tw)));
    }
    draw->pop_clip_rect(dl);
}

static float s_sec_alpha[5][8] = {};
static float s_sec_rise[5][8] = {};
static float s_row_alpha[5][8][32] = {};
static float s_slide_x = 0.f;
static int s_sec_tab = -1;

static void section_anims_reset(int tab) {
    if (tab >= 0 && tab < 5) {
        for (int s = 0; s < 8; s++) {
            s_sec_alpha[tab][s] = 0.f;
            s_sec_rise[tab][s] = 10.f + s * 4.f;
            for (int r = 0; r < 32; r++)
                s_row_alpha[tab][s][r] = 0.f;
        }
    }
    s_slide_x = 22.f;
    s_sec_tab = tab;
}

static void switch_tab(int t) {
    if (t < 0 || t > 4 || t == var->gui.active_tab)
        return;
    var->gui.active_tab = t;
    var->gui.tab_transition_alpha = 0.f;
    var->gui.section_transition_alpha = 0.f;
    section_anims_reset(t);
}

// ============================================================================
// main frame
// ============================================================================
static const char* k_extra_tab_name = "colors";
static const char* k_extra_tab_icon = "\xEF\x94\xBF";

void c_gui::render() {
    font->update();
    theming_tick();
    poll_keybind_listen();
    cloud_drain();
    notify->setup_notify();

    // overlays live outside the menu window so they work while closed.
    // each widget self-gates on its spawn alpha - eased in overlays_tick().
    overlays_tick();

    static bool s_last_open = false;
    static bool s_open_told = false;
    static bool s_begin_failed_told = false;
    if (!var->gui.menu_open) {
        s_last_open = false;
        s_open_told = false;
        s_begin_failed_told = false;
        var->gui.menu_open_alpha = 0.f;
        return;
    }
    if (!s_last_open) {
        s_last_open = true;
        var->gui.menu_open_alpha = 0.f;
        section_anims_reset(var->gui.active_tab);
    }
    const float open_alpha = gui->easing(var->gui.menu_open_alpha, 1.f, 8.f, dynamic_easing);

    // hotkeys 1-5 switch tabs (never while typing in a text field)
    if (!ImGui::GetIO().WantTextInput) {
        for (int k = 0; k < 5; k++)
            if (GetAsyncKeyState('1' + k) & 1)
                switch_tab(k);
    }

    gui->set_next_window_size(ImVec2(SCALE(680.f), SCALE(480.f)));
    // nullptr close button: F1 owns the toggle, no stray X clicks.
    if (!gui->begin("ivory", nullptr)) {
        gui->end();
        if (!s_begin_failed_told) {
            s_begin_failed_told = true;
            notifications::add("menu window failed to open");
        }
        return;
    }
    // live rect: overlays dock against it, and the open toast proves layout.
    var->gui.menu_rect_min = gui->window_pos();
    var->gui.menu_rect_size = ImVec2(gui->window_width(), gui->window_height());
    var->gui.menu_rect_valid = true;
    if (!s_open_told) {
        s_open_told = true;
        char ob[96];
        sprintf_s(ob, "menu opened %.0fx%.0f", gui->window_width(), gui->window_height());
        notifications::add(ob);
    }
    ImGui::PushStyleVar(ImGuiStyleVar_Alpha, open_alpha);

    ImDrawList* dl = gui->window_drawlist();
    const ImVec2 wp = gui->window_pos();
    const float ww = gui->window_width();
    const float wh = gui->window_height();

    // header hairline: glow + hairline + hot center
    {
        const float hy = wp.y + SCALE(34.f);
        const float x0 = wp.x + SCALE(12.f), x1 = wp.x + ww - SCALE(12.f);
        dl->AddLine(ImVec2(x0, hy + 1), ImVec2(x1, hy + 1), IM_COL32(178, 156, 255, 22), 3.0f);
        dl->AddLine(ImVec2(x0, hy), ImVec2(x1, hy), IM_COL32(178, 156, 255, 70), 1.0f);
        dl->AddLine(ImVec2(wp.x + ww * 0.35f, hy), ImVec2(wp.x + ww * 0.65f, hy),
            IM_COL32(190, 172, 255, 150), 1.0f);
    }

    const float side_w = SCALE(148.f);
    const ImVec2 avail = gui->content_avail();

    static float s_pill_y = -1.f;
    static float s_pill_h = 20.f;
    float pill_target_y = -1.f;

    gui->begin_content("sidebar", ImVec2(side_w, 0));
    for (int t = 0; t < 5; t++) {
        const char* name = (t < 4) ? tab_names[t] : k_extra_tab_name;
        const char* icon = (t < 4) ? tab_icons[t] : k_extra_tab_icon;
        char buf[96];
        sprintf_s(buf, "%s  %s%s", icon, (t == var->gui.active_tab) ? "> " : "", name);
        if (widgets->button(buf))
            switch_tab(t);
        if (t == var->gui.active_tab) {
            const ImVec2 mn = ImGui::GetItemRectMin();
            const ImVec2 mx = ImGui::GetItemRectMax();
            pill_target_y = mn.y;
            s_pill_h = mx.y - mn.y;
            // rail pill drawn after layout, below
            if (s_pill_y < 0.f) s_pill_y = pill_target_y;
        }
    }
    gui->end_content();

    // sliding rail indicator eases toward the active tab
    if (pill_target_y >= 0.f) {
        if (s_pill_y < 0.f) s_pill_y = pill_target_y;
        s_pill_y += (pill_target_y - s_pill_y) * fminf(1.f, ImGui::GetIO().DeltaTime * 14.f);
        const float px = wp.x + SCALE(6.f);
        dl->AddRectFilled(ImVec2(px, s_pill_y + 4), ImVec2(px + SCALE(3.f), s_pill_y + s_pill_h - 4),
            IM_COL32(178, 156, 255, (int)(220 * open_alpha)), SCALE(2.f));
    }

    gui->sameline();

    gui->begin_content("main", ImVec2(avail.x - side_w - SCALE(8.f), 0));
    const float alpha = gui->easing(var->gui.tab_transition_alpha, 1.f, 6.f, dynamic_easing);
    ImGui::PushStyleVar(ImGuiStyleVar_Alpha, alpha);

    const int tab = var->gui.active_tab;
    if (s_sec_tab != tab)
        section_anims_reset(tab);

    // content slides in from the right while fading, once per tab switch
    s_slide_x += (0.f - s_slide_x) * fminf(1.f, ImGui::GetIO().DeltaTime * 11.f);
    if (s_slide_x > 0.25f)
        ImGui::Indent(s_slide_x);

    if (tab == 3) {
        render_players_tab();
    } else if (tab == 4) {
        render_colours_tab();
    } else if (tab >= 0 && tab < 3) {
        for (int s = 0; s < k_section_counts[tab]; s++) {
            float& sa = s_sec_alpha[tab][s];
            float& sr = s_sec_rise[tab][s];
            gui->easing(sa, 1.f, 7.f, dynamic_easing);
            gui->easing(sr, 0.f, 10.f, dynamic_easing);
            if (sr > 0.5f)
                gui->dummy(ImVec2(0, sr));
            ImGui::PushStyleVar(ImGuiStyleVar_Alpha, sa);
            if (child_titles[tab][s]) {
                ImGui::TextUnformatted(child_titles[tab][s]);
                // accent tick grows under the title with the section fade
                const ImVec2 tp = ImGui::GetCursorScreenPos();
                const float tw = ImGui::CalcTextSize(child_titles[tab][s]).x;
                dl->AddLine(tp + ImVec2(0, 1), tp + ImVec2(tw * sa, 1),
                    IM_COL32(178, 156, 255, (int)(160 * sa * open_alpha)), 2.0f);
                gui->dummy(SCALE(0.f, 3.f));
            }
            const int nrows = k_settings_row_counts[tab][s];
            for (int i = 0; i < nrows && i < 32; i++) {
                float& ra = s_row_alpha[tab][s][i];
                // later rows ease slower so the section cascades downward
                const float spd = 9.f - (i > 8 ? 8 : i) * 0.5f;
                gui->easing(ra, 1.f, spd, dynamic_easing);
                ImGui::PushStyleVar(ImGuiStyleVar_Alpha, ra);
                render_row(k_settings_rows[tab][s][i]);
                ImGui::PopStyleVar();
            }
            ImGui::PopStyleVar();
            gui->dummy(SCALE(0.f, 6.f));
        }
    }

    if (s_slide_x > 0.25f)
        ImGui::Unindent(s_slide_x);

    ImGui::PopStyleVar();
    gui->end_content();

    dust_tick(dl, wp, ww, wh);

    ImGui::PopStyleVar();
    gui->end();
}

// ============================================================================
// slot configs (memory-backed) + boot
// ============================================================================
static std::string slot_name(int slot) {
    char b[32];
    sprintf_s(b, "slot %d", slot);
    return b;
}

bool c_gui::save_config(int slot)   { return config::save_config_mem(slot_name(slot)); }
bool c_gui::load_config(int slot)   { return config::load_config_mem(slot_name(slot)); }
void c_gui::delete_config(int slot) { config::delete_config_mem(slot_name(slot)); }
void c_gui::reset_defaults()        { config::reset_to_defaults(); }

void c_gui::boot_config() {
    if (cfg_auto_load)
        config::load_autoload();
}
