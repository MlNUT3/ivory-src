struct SettingRow
{
    int         type;        // see row types below
    const char* label;
    void*       ptr;         // primary value
    void*       ptr2;        // secondary (keybind mode)
    float       mn, mx;
    const char* const* items;
    int         items_count;
    int         cond;        // visibility condition (see below)
};

enum : int
{
    ROW_CHECK = 0,
    ROW_SLIDER_I,
    ROW_SLIDER_F,
    ROW_COMBO,
    ROW_COLOR,
    ROW_KEYBIND,
    ROW_INFO,
    ROW_BUTTON,
    ROW_INPUT,   // single-line text input bound to a char buffer (ptr)
    ROW_CONFIGLIST, // clickable list of the configs currently in memory
};

// row visibility conditions (evaluated against aim_mode at render time)
enum : int
{
    COND_ALWAYS = 0,
    COND_NOT_BLATANT,   // hidden in blatant mode
    COND_HUMANIZED,     // only in humanized mode
    COND_BLATANT,       // only in blatant mode
    COND_BOOL,          // visible while *(bool*)ptr2 is true
};

#define R_CHECK(label, ptr)          { ROW_CHECK,    label, (void*)(ptr), nullptr, 0, 0, nullptr, 0, COND_ALWAYS }
#define R_SLIDER_I(label, ptr, mn, mx) { ROW_SLIDER_I, label, (void*)(ptr), nullptr, (float)(mn), (float)(mx), nullptr, 0, COND_ALWAYS }
#define R_SLIDER_F(label, ptr, mn, mx) { ROW_SLIDER_F, label, (void*)(ptr), nullptr, mn, mx, nullptr, 0, COND_ALWAYS }
#define R_COMBO(label, ptr, items_)   { ROW_COMBO,   label, (void*)(ptr), nullptr, 0, 0, items_, (int)(sizeof(items_)/sizeof(items_[0])), COND_ALWAYS }
#define R_COLOR(label, ptr)          { ROW_COLOR,    label, (void*)(ptr), nullptr, 0, 0, nullptr, 0, COND_ALWAYS }
#define R_KEYBIND(label, key, mode)  { ROW_KEYBIND,  label, (void*)(key), (void*)(mode), 0, 0, nullptr, 0, COND_ALWAYS }
#define R_INFO(text)                  { ROW_INFO,     text,  nullptr, nullptr, 0, 0, nullptr, 0, COND_ALWAYS }
#define R_BUTTON(label, fn)           { ROW_BUTTON,   label, nullptr, (void*)(fn), 0, 0, nullptr, 0, COND_ALWAYS }
// bool-gated variants (ptr2 = pointer to the enabling bool)
#define R_CHECK_B(label, ptr, gate)        { ROW_CHECK,    label, (void*)(ptr), (void*)(gate), 0, 0, nullptr, 0, COND_BOOL }
#define R_SLIDER_I_B(label, ptr, mn, mx, gate) { ROW_SLIDER_I, label, (void*)(ptr), (void*)(gate), (float)(mn), (float)(mx), nullptr, 0, COND_BOOL }
#define R_SLIDER_F_B(label, ptr, mn, mx, gate) { ROW_SLIDER_F, label, (void*)(ptr), (void*)(gate), mn, mx, nullptr, 0, COND_BOOL }
#define R_COMBO_B(label, ptr, items_, gate)    { ROW_COMBO,   label, (void*)(ptr), (void*)(gate), 0, 0, items_, (int)(sizeof(items_)/sizeof(items_[0])), COND_BOOL }
// conditional variants (visibility depends on aim_mode)
#define R_CHECK_NB(label, ptr)        { ROW_CHECK,    label, (void*)(ptr), nullptr, 0, 0, nullptr, 0, COND_NOT_BLATANT }
#define R_CHECK_HUM(label, ptr)       { ROW_CHECK,    label, (void*)(ptr), nullptr, 0, 0, nullptr, 0, COND_HUMANIZED }
#define R_SLIDER_I_HUM(label, ptr, mn, mx) { ROW_SLIDER_I, label, (void*)(ptr), nullptr, (float)(mn), (float)(mx), nullptr, 0, COND_HUMANIZED }
#define R_SLIDER_F_NB(label, ptr, mn, mx) { ROW_SLIDER_F, label, (void*)(ptr), nullptr, mn, mx, nullptr, 0, COND_NOT_BLATANT }
#define R_SLIDER_F_HUM(label, ptr, mn, mx) { ROW_SLIDER_F, label, (void*)(ptr), nullptr, mn, mx, nullptr, 0, COND_HUMANIZED }
#define R_INPUT(label, bufptr)            { ROW_INPUT,    label, (void*)(bufptr), nullptr, 0, 0, nullptr, 0, COND_ALWAYS }
#define R_CONFIGLIST()                    { ROW_CONFIGLIST, nullptr, nullptr, nullptr, 0, 0, nullptr, 0, COND_ALWAYS }
#define R_INFO_B(text)                { ROW_INFO,     text,  nullptr, nullptr, 0, 0, nullptr, 0, COND_BLATANT }

// ============================================================================
// ui state + config actions
// ============================================================================
static int g_cfg_slot = 0;
// memory-config UI state - the name buffer feeds the ROW_INPUT field
static char g_cfg_name[64] = {};
static char g_cloud_id[64] = {};
static std::chrono::steady_clock::time_point g_sd_armed{};
static bool g_sd_armed_active = false;

// cloud slots: worker threads never touch ui or settings - they only fill
// these, and the render loop drains/applies/notifies below
struct CloudSlot { bool busy = false; bool ready = false; bool ok = false; std::string text; };
static CloudSlot g_cloud_share;
static CloudSlot g_cloud_fetch;
static std::mutex g_cloud_mu;

static void cfg_act_newname() {
    static const char hex[] = "0123456789ABCDEF";
    std::string n;
    for (int i = 0; i < 12; i++) n += hex[rand() % 16];
    strncpy_s(g_cfg_name, n.c_str(), sizeof(g_cfg_name) - 1);
}
static void cfg_act_save() {
    std::string name = g_cfg_name;
    if (name.empty()) { notifications::add("type a config name first"); return; }
    if (config::save_config_mem(name))
        notifications::add("config saved to memory");
    else
        notifications::add("config save failed");
}
static void cfg_act_load() {
    std::string name = g_cfg_name;
    if (name.empty()) { notifications::add("type a config name first"); return; }
    if (config::load_config_mem(name))
        notifications::add("config loaded");
    else
        notifications::add("no config with that name");
}
static void cfg_act_delete() {
    std::string name = g_cfg_name;
    if (name.empty()) { notifications::add("type a config name first"); return; }
    if (config::delete_config_mem(name))
    {
        SecureZeroMemory(&name[0], name.size());
        notifications::add("config deleted from memory");
    }
    else
        notifications::add("no config with that name");
}
static void cfg_act_export() {
    if (config::export_config_to_clipboard())
        notifications::add("config exported to clipboard");
    else
        notifications::add("export failed");
}
static void cfg_act_insert() {
    if (config::import_config_from_clipboard())
        notifications::add("config inserted from clipboard");
    else
        notifications::add("insert failed (no config in clipboard?)");
}
static void cfg_act_cloud_share() {
    std::lock_guard<std::mutex> lk(g_cloud_mu);
    if (g_cloud_share.busy) { notifications::add("upload already running"); return; }
    g_cloud_share.busy = true;
    g_cloud_share.ready = false;
    g_cloud_share.text.clear();
    notifications::add("uploading config...");
    std::thread([] {
        std::string url;
        const bool ok = config::share_config_cloud(url);
        std::lock_guard<std::mutex> lk(g_cloud_mu);
        g_cloud_share.ok = ok;
        g_cloud_share.text = url;
        g_cloud_share.ready = true;
        g_cloud_share.busy = false;
    }).detach();
}
static void cfg_act_cloud_fetch() {
    std::string id = g_cloud_id;
    if (id.empty()) { notifications::add("paste a paste id first"); return; }
    std::lock_guard<std::mutex> lk(g_cloud_mu);
    if (g_cloud_fetch.busy) { notifications::add("fetch already running"); return; }
    g_cloud_fetch.busy = true;
    g_cloud_fetch.ready = false;
    g_cloud_fetch.text.clear();
    notifications::add("fetching config...");
    std::thread([id] {
        std::string body;
        const bool ok = config::fetch_config_cloud_body(id, body);
        std::lock_guard<std::mutex> lk(g_cloud_mu);
        g_cloud_fetch.ok = ok;
        g_cloud_fetch.text = body;
        g_cloud_fetch.ready = true;
        g_cloud_fetch.busy = false;
    }).detach();
}
static void cfg_act_selfdestruct() {
    // two-stage: first press arms, second press within 8s confirms
    const auto now = std::chrono::steady_clock::now();
    if (!g_sd_armed_active || (now - g_sd_armed) > std::chrono::seconds(8))
    {
        g_sd_armed_active = true;
        g_sd_armed = now;
        notifications::add("press self destruct again to confirm");
        return;
    }
    g_sd_armed_active = false;
    notifications::add("wiping...");
    Sleep(150); // let the notification render before everything dies
    sys_eject::self_destruct();
}
static void cfg_act_reset() {
    config::reset_to_defaults();
    notifications::add("settings reset to defaults");
}

