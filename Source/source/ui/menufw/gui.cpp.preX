// ============================================================================
// row rendering
// ============================================================================
static int* g_listen_key = nullptr;

static const char* vk_name(int vk) {
    switch (vk) {
        case 0: return "none";
        case VK_LBUTTON: return "mouse1";
        case VK_RBUTTON: return "mouse2";
        case VK_MBUTTON: return "mouse3";
        case VK_XBUTTON1: return "mouse4";
        case VK_XBUTTON2: return "mouse5";
        case VK_SHIFT: return "shift";
        case VK_CONTROL: return "ctrl";
        case VK_MENU: return "alt";
        case VK_CAPITAL: return "caps";
        case VK_SPACE: return "space";
        case VK_INSERT: return "insert";
        case VK_DELETE: return "delete";
        case VK_HOME: return "home";
        case VK_END: return "end";
        default: break;
    }
    static char buf[32];
    if (vk >= 0x30 && vk <= 0x39) { buf[0] = (char)vk; buf[1] = 0; return buf; }
    if (vk >= 0x41 && vk <= 0x5A) { buf[0] = (char)vk; buf[1] = 0; return buf; }
    if (vk >= VK_F1 && vk <= VK_F24) { sprintf_s(buf, "f%d", vk - VK_F1 + 1); return buf; }
    sprintf_s(buf, "vk%d", vk);
    return buf;
}

static bool row_visible(const SettingRow& r) {
    const int aim_mode = settings::aimbot::aim_mode;
    switch (r.cond) {
        case COND_NOT_BLATANT: return aim_mode != 2;
        case COND_HUMANIZED:   return aim_mode == 0;
        case COND_BLATANT:     return aim_mode == 2;
        case COND_BOOL:        return r.ptr2 && *(bool*)r.ptr2;
        default:               return true;
    }
}

static void poll_keybind_listen() {
    if (!g_listen_key) return;
    // esc cancels, everything else binds (first pressed wins)
    if (GetAsyncKeyState(VK_ESCAPE) & 0x8000) { g_listen_key = nullptr; return; }
    for (int vk = 8; vk <= 254; vk++) {
        if (vk == VK_ESCAPE) continue;
        if (GetAsyncKeyState(vk) & 0x8000) {
            *g_listen_key = vk;
            g_listen_key = nullptr;
            return;
        }
    }
}

static void render_row(const SettingRow& r) {
    if (!row_visible(r)) return;
    switch (r.type) {
        case ROW_CHECK:
            widgets->checkbox(r.label, (bool*)r.ptr);
            break;
        case ROW_SLIDER_I:
            widgets->slider_int(r.label, (int*)r.ptr, (int)r.mn, (int)r.mx);
            break;
        case ROW_SLIDER_F:
            widgets->slider_float(r.label, (float*)r.ptr, r.mn, r.mx);
            break;
        case ROW_COMBO:
            widgets->dropdown(r.label, (int*)r.ptr, (const char**)r.items, r.items_count);
            break;
        case ROW_COLOR:
            widgets->color_picker(r.label, (float*)r.ptr);
            break;
        case ROW_KEYBIND: {
            int* key = (int*)r.ptr;
            char buf[128];
            if (g_listen_key == key)
                sprintf_s(buf, "%s [...] ", r.label);
            else
                sprintf_s(buf, "%s [%s] ", r.label, vk_name(*key));
            if (widgets->button(buf))
                g_listen_key = (g_listen_key == key) ? nullptr : key;
            break;
        }
        case ROW_INFO:
            ImGui::TextDisabled("%s", r.label);
            break;
        case ROW_BUTTON:
            if (widgets->button(r.label) && r.ptr2)
                ((void(*)())r.ptr2)();
            break;
        case ROW_INPUT:
            ImGui::InputText(r.label, (char*)r.ptr, 64);
            break;
        case ROW_CONFIGLIST: {
            auto names = config::get_config_list_mem();
            if (names.empty()) {
                ImGui::TextDisabled("%s", "no configs in memory yet");
            } else {
                for (size_t i = 0; i < names.size(); i++) {
                    gui->push_id((int)i);
                    const bool sel = (g_cfg_name == names[i]);
                    char buf[128];
                    sprintf_s(buf, "%s%s", sel ? "> " : "", names[i].c_str());
                    if (widgets->button(buf)) {
                        strncpy_s(g_cfg_name, names[i].c_str(), sizeof(g_cfg_name) - 1);
                        if (config::load_config_mem(names[i]))
                            notifications::add("config loaded");
                    }
                    gui->pop_id();
                }
            }
            break;
        }
    }
}

// drain finished cloud workers: apply on the render thread, notify here
static void cloud_drain() {
    std::lock_guard<std::mutex> lk(g_cloud_mu);
    if (g_cloud_share.ready) {
        g_cloud_share.ready = false;
        if (g_cloud_share.ok && !g_cloud_share.text.empty()) {
            ImGui::SetClipboardText(g_cloud_share.text.c_str());
            notifications::add("upload done - link copied to clipboard");
        } else {
            notifications::add("upload failed");
        }
        g_cloud_share.text.clear();
    }
    if (g_cloud_fetch.ready) {
        g_cloud_fetch.ready = false;
        if (g_cloud_fetch.ok && !g_cloud_fetch.text.empty()) {
            if (config::apply_fetched_config(g_cloud_fetch.text))
                notifications::add("cloud config applied");
            else
                notifications::add("cloud config invalid");
        } else {
            notifications::add("fetch failed");
        }
        g_cloud_fetch.text.clear();
    }
}

// ============================================================================
// players tab
// ============================================================================
static void render_players_tab() {
    auto snap = cache::get_players_snap();
    if (!snap || snap->empty()) {
        ImGui::TextDisabled("%s", "no players cached yet");
        return;
    }
    for (size_t i = 0; i < snap->size(); i++) {
        const auto& p = (*snap)[i];
        const std::uint64_t addr = p.instance.address;
        if (!addr) continue;
        gui->push_id((int)i);
        std::string name = playertools::ops::display_for(addr);
        if (name.empty()) name = p.display_name.empty() ? p.name : p.display_name;
        char buf[160];
        sprintf_s(buf, "%s  [%d hp]", name.c_str(), (int)p.health);
        ImGui::TextUnformatted(buf);
        gui->sameline();
        if (widgets->button("teleport")) {
            if (!playertools::ops::teleport_to(addr))
                notifications::add("teleport failed");
        }
        gui->sameline();
        const bool spec = playertools::ops::is_spectating(addr);
        if (widgets->button(spec ? "stop" : "spectate")) {
            if (spec) playertools::ops::stop_spectate();
            else playertools::ops::spectate(addr);
        }
        gui->pop_id();
    }
}

